# Секреты и локальные настройки; примеры без секретов можно хранить в Git.
.env
.env.*
!.env.example
!.env.*.example
/secrets/

# Локальные временные файлы.
.DS_Store
Thumbs.db
*.swp
*.swo
*.log
/.cache/
/tmp/

# Локальная среда вспомогательных Python-скриптов.
__pycache__/
*.py[cod]
/.venv/

# records/ и docs/ намеренно не исключены: это знания и история проекта.
# Зависимости и результаты сборки добавляются сюда после выбора стека.
/frontend/node_modules/
/frontend/dist/
/frontend/*.tsbuildinfo
/frontend/playwright-report/
/frontend/test-results/
/.pytest_cache/
/.ruff_cache/
